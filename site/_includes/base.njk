<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#134686" media="(prefers-color-scheme: light)"/>
  <meta name="theme-color" content="#102d51" media="(prefers-color-scheme: dark)"/>
  <meta name="author" content="Nando Rossi"/>
  <meta name="description" content="{{ description }}"/>
  {% if redirectTo %}<noscript><meta http-equiv="refresh" content="0;url={{ redirectTo | url }}"/></noscript>{% endif %}
  <title>{% if navKey == 'home' %}OCP: {{ title }}{% else %}{{ title }} — OCP{% endif %}</title>
  {% if navKey == 'home' %}
  <meta property="og:title" content="OCP: {{ title }}"/>
  <meta property="og:description" content="{{ description }}"/>
  <meta property="og:type" content="website"/>
  <meta property="og:image" content="https://ocp.nan.do/ocp-social.png"/>
  <meta property="og:image:alt" content="One OCP source generating the same agent setup on a laptop and a desktop."/>
  <meta name="twitter:card" content="summary_large_image"/>
  {% endif %}
  <style data-site-styles>{% siteStyles %}</style>
  <link rel="icon" href="{{ '/logo.svg' | url }}" type="image/svg+xml"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Nunito+Sans:wght@400;500;600;650;700;750;800;850&family=Stardos+Stencil:wght@400;700&family=Work+Sans:wght@800&display=swap" rel="stylesheet"/>
  <script type="module" src="{{ '/assets/main.js' | url }}"></script>
</head>
<body data-page="{{ navKey }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="landing-nav">
    <a href="{{ '/' | url }}" class="brand desktop-brand" aria-label="OCP home"><img src="{{ '/logo.svg' | url }}" alt="" width="36" height="36"/><span>OCP<span class="brand-period">.</span></span></a>
    <nav aria-label="Main navigation"><a href="{{ '/docs/' | url }}"{% if navKey == 'docs' %} aria-current="page"{% endif %}>Docs</a><a href="{{ '/quick-start/' | url }}"{% if navKey == 'quick-start' %} aria-current="page"{% endif %}>Quick start</a><a href="https://github.com/nandorocker/ocp">GitHub</a><a class="button button-primary" href="{% if navKey == 'home' %}#getting-started{% else %}{{ '/quick-start/' | url }}#install{% endif %}">Install <span aria-hidden="true">→</span></a></nav>
  </header>
  <div class="page-shell">
    {{ content | safe }}
  </div>
  <footer class="page-footer"><nav class="footer-links" aria-label="Footer"><a href="{{ '/docs/' | url }}">Docs</a><a href="{{ '/quick-start/' | url }}">Quick start</a><a href="{{ '/docs/' | url }}#commands">Command reference</a><a href="{{ '/quick-start/' | url }}#install">Install</a><a href="https://github.com/nandorocker/ocp/issues">Feedback &amp; ideas</a><a href="https://github.com/nandorocker/ocp">GitHub</a></nav><div class="footer-credit">Made by <a href="https://nan.do">Nando Rossi</a> • License <a href="https://github.com/nandorocker/ocp/blob/main/LICENSE">AGPL-3.0</a> • © 2026</div><div class="footer-support"><span>Find this useful? Support me!</span><a class="coffee-link" href="https://buymeacoffee.com/nandorossi" target="_blank" rel="noopener noreferrer">{% include 'cup.njk' %}Buy me a coffee</a></div></footer>
  <div id="copy-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
  <div id="copy-toast" class="copy-toast" aria-hidden="true" hidden></div>
</body>
</html>
