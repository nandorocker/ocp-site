<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#315b8c"/>
  <meta name="author" content="Nando Rossi"/>
  <meta name="description" content="{{ description }}"/>
  <title>{% if navKey == 'home' %}OCP — Your coding-agent config. Every machine.{% else %}{{ title }} — OCP{% endif %}</title>
  <link rel="icon" href="{{ '/logo.png' | url }}" type="image/png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=DM+Mono:wght@400;500&family=Nunito+Sans:wght@400;500;600;650;700;750;800;850&family=Work+Sans:wght@800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}"/>
  <script type="module" src="{{ '/assets/main.js' | url }}"></script>
</head>
<body data-page="{{ navKey }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="mobile-header">
    <div><a href="{{ '/' | url }}" class="brand"><img src="{{ '/logo.png' | url }}" alt="" width="32" height="32"/><span>OCP<span class="brand-period">.</span></span></a><p class="mobile-motto">Thank you for your configuration.</p></div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="sidebar" hidden>Menu <span aria-hidden="true">☰</span></button>
  </header>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand"><a href="{{ '/' | url }}" class="brand desktop-brand" aria-label="OCP home"><img src="{{ '/logo.png' | url }}" alt="" width="42" height="42"/><span>OCP<span class="brand-period">.</span></span></a><p class="sidebar-description">Thank you for your configuration.</p></div>
    <nav aria-label="Main navigation">
      {% for item in navigation %}
      <a class="nav-link{% if navKey == item.key %} active{% endif %}" href="{{ item.href | url }}"{% if navKey == item.key %} aria-current="page"{% endif %}>{% set icon = item.icon %}{% include 'icon.njk' %}<span>{{ item.title }}</span></a>
      {% endfor %}
      <a class="nav-link feedback-link" href="https://github.com/nandorocker/ocp/issues"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21 3.5 12.5a5.5 5.5 0 0 1 8.5-7 5.5 5.5 0 0 1 8.5 7Z"/></svg><span>Feedback &amp; ideas</span></a>
    </nav>
    <a class="repository-summary" href="https://github.com/nandorocker/ocp" aria-label="OCP on GitHub">
      <svg class="repository-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2.5"/><circle cx="6" cy="19" r="2.5"/><circle cx="18" cy="5" r="2.5"/><path d="M6 7.5v9M18 7.5v1a6 6 0 0 1-6 6H6"/></svg>
      <span class="repository-details"><span class="repository-name">nandorocker/ocp</span><span class="repository-stats"><span data-repository="release" aria-label="Releases"><span>Releases</span></span><span data-repository="stars" aria-label="Stars"><span>Stars</span></span><span data-repository="forks" aria-label="Forks"><span>Forks</span></span></span></span>
    </a>
    <div class="sidebar-footer"><div class="sidebar-credit"><span>Made by <a href="https://nan.do">Nando Rossi</a></span><a class="coffee-link coffee-link-mini" href="https://buymeacoffee.com/nandorossi" target="_blank" rel="noopener noreferrer" aria-label="Buy me a coffee" title="Buy me a coffee">{% include 'cup.njk' %}</a></div><a href="https://github.com/nandorocker/ocp/blob/main/LICENSE">AGPL-3.0</a></div>
  </aside>
  <div class="page-shell">
    <div class="topline"><a href="{{ '/docs/' | url }}">OCP documentation</a><a href="https://github.com/nandorocker/ocp">GitHub</a></div>
    {{ content | safe }}
    <footer class="page-footer"><div class="footer-credit">Made by <a href="https://nan.do">Nando Rossi</a><br/><a href="https://github.com/nandorocker/ocp/blob/main/LICENSE">Open source, AGPL-3.0</a></div><div class="footer-support"><span>Find this useful?</span><a class="coffee-link" href="https://buymeacoffee.com/nandorossi" target="_blank" rel="noopener noreferrer">{% include 'cup.njk' %}Buy me a coffee</a></div></footer>
  </div>
  <div class="sr-only" id="copy-status" role="status" aria-live="polite"></div>
</body>
</html>
