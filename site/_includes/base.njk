<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#134686" media="(prefers-color-scheme: light)"/>
  <meta name="theme-color" content="#102d51" media="(prefers-color-scheme: dark)"/>
  <meta name="author" content="Nando Rossi"/>
  <meta name="description" content="{{ description }}"/>
  <title>{% if navKey == 'home' %}OCP: {{ title }}{% else %}{{ title }} — OCP{% endif %}</title>
  {% if navKey == 'home' %}
  <meta property="og:title" content="OCP: {{ title }}"/>
  <meta property="og:description" content="{{ description }}"/>
  <meta property="og:type" content="website"/>
  <meta property="og:image" content="https://ocp.nan.do/ocp-social.png"/>
  <meta property="og:image:alt" content="One OCP source generating the same agent setup on a laptop and a desktop."/>
  <meta name="twitter:card" content="summary_large_image"/>
  {% endif %}
  <style data-site-styles>{% siteStyles %}</style>
  <link rel="icon" href="{{ '/logo.svg' | url }}" type="image/svg+xml"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Nunito+Sans:wght@400;500;600;650;700;750;800;850&family=Stardos+Stencil:wght@400;700&family=Work+Sans:wght@800&display=swap" rel="stylesheet"/>
  <script type="module" src="{{ '/assets/main.js' | url }}"></script>
</head>
<body data-page="{{ navKey }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% if navKey == 'home' %}
  <header class="landing-nav">
    <a href="{{ '/' | url }}" class="brand desktop-brand" aria-label="OCP home"><img src="{{ '/logo.svg' | url }}" alt="" width="36" height="36"/><span>OCP<span class="brand-period">.</span></span></a>
    <nav aria-label="Main navigation"><a href="{{ '/docs/' | url }}">Docs</a><a href="{{ '/quick-start/' | url }}">Quick start</a><a href="https://github.com/nandorocker/ocp">GitHub</a><a class="button button-primary" href="#getting-started">Install</a></nav>
  </header>
  {% else %}
  <header class="mobile-header">
    <div><a href="{{ '/' | url }}" class="brand"><img src="{{ '/logo.svg' | url }}" alt="" width="32" height="32"/><span>OCP<span class="brand-period">.</span></span></a></div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="sidebar" hidden>Menu <span aria-hidden="true">☰</span></button>
  </header>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand"><a href="{{ '/' | url }}" class="brand desktop-brand" aria-label="OCP home"><img src="{{ '/logo.svg' | url }}" alt="" width="42" height="42"/><span>OCP<span class="brand-period">.</span></span></a></div>
    <nav aria-label="Main navigation">
      {% for item in navigation %}
      <a class="nav-link{% if navKey == item.key %} active{% endif %}" href="{{ item.href | url }}"{% if navKey == item.key %} aria-current="page"{% endif %}>{% set icon = item.icon %}{% include 'icon.njk' %}<span>{{ item.title }}</span></a>
      {% endfor %}
      <a class="nav-link feedback-link" href="https://github.com/nandorocker/ocp/issues"><svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M12 21 3.5 12.5a5.5 5.5 0 0 1 8.5-7 5.5 5.5 0 0 1 8.5 7Z"/></svg><span>Feedback &amp; ideas</span></a>
    </nav>
    <a class="repository-summary" href="https://github.com/nandorocker/ocp" aria-label="OCP on GitHub">
      <svg class="repository-mark" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2.5"/><circle cx="6" cy="19" r="2.5"/><circle cx="18" cy="5" r="2.5"/><path d="M6 7.5v9M18 7.5v1a6 6 0 0 1-6 6H6"/></svg>
      <span class="repository-details"><span class="repository-name">nandorocker/ocp</span><span class="repository-stats"><span data-repository="release" aria-label="Releases"><span>Releases</span></span><span data-repository="stars" aria-label="Stars"><span>Stars</span></span><span data-repository="forks" aria-label="Forks"><span>Forks</span></span></span></span>
    </a>
  </aside>
  {% endif %}
  <div class="page-shell">
    {{ content | safe }}
    <footer class="page-footer"><nav class="footer-links" aria-label="Footer"><a href="{{ '/docs/' | url }}">Docs</a><a href="{{ '/quick-start/' | url }}">Quick start</a><a href="{{ '/docs/' | url }}#commands">Command reference</a><a href="{{ '/install/' | url }}">Install</a><a href="https://github.com/nandorocker/ocp/issues">Feedback &amp; ideas</a><a href="https://github.com/nandorocker/ocp">GitHub</a></nav><div class="footer-credit">Made by <a href="https://nan.do">Nando Rossi</a><br/><a href="https://github.com/nandorocker/ocp/blob/main/LICENSE">Open source, AGPL-3.0</a></div><div class="footer-support"><a class="coffee-link" href="https://buymeacoffee.com/nandorossi" target="_blank" rel="noopener noreferrer">{% include 'cup.njk' %}Buy me a coffee</a></div></footer>
  </div>
  <div id="copy-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
  <div id="copy-toast" class="copy-toast" aria-hidden="true" hidden></div>
</body>
</html>
